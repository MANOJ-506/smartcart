# =========================================================
# SmartCart Environment Configuration Template
# =========================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# On Render.com, set these key-value pairs in:
#   Dashboard -> Your Web Service -> Environment Variables
# =========================================================

# Flask Session Security Key (Generate a random string)
SECRET_KEY=your-random-secret-key-here

# Flask Environment (production or development)
FLASK_ENV=production

# Database Configuration (Optional SQLite path override)
# Defaults to smartcart.db in project root
# DATABASE_PATH=smartcart.db

# Flask-Mail / Gmail SMTP Configuration
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# Razorpay Payment Gateway Keys (Test or Live)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Server Port (Render sets this dynamically)
PORT=5000
